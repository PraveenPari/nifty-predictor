# =====================================================================
# Nifty Predictor Pro — Environment Template
# Copy to `.env` (same folder) and fill in REAL values. NEVER commit `.env`.
#   cp .env.example .env
# On hosting (Render/Railway): set these in the provider's Secrets dashboard.
# =====================================================================

# --- Breeze API (ICICI Direct) — REQUIRED for live broker data ---
# Get from: https://api.icicidirect.com (developer portal)
BREEZE_API_KEY=
BREEZE_SECRET_KEY=
# Daily session token: open the URL from /api/breeze-login-url in a browser,
# log in, then copy `apisession` from the redirected URL. Expires daily —
# refresh every trading morning.
BREEZE_SESSION_TOKEN=

# --- Angel One (optional second source) ---
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# --- Flask ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-32-byte-hex
FLASK_ENV=production
# Port is injected by hosts automatically; only set locally if needed.
PORT=5000

# --- Lot sizes (override when NSE revises contracts) ---
LOT_SIZE_NIFTY=75
LOT_SIZE_BANKNIFTY=30

# --- Optional: databases (features degrade gracefully without them) ---
MONGO_URI=
REDIS_URL=
