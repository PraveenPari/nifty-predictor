{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd nifty-predictor-python && pip install --upgrade pip && pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "cd nifty-predictor-python && gunicorn -c gunicorn.conf.py app:app",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
